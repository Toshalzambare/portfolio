# PORT for the backend Express server (defaults to 5000)
PORT=5000

# Secure Admin Authentication Credentials
# (These will be automatically generated and written to your .env file by running `node set-password.js`)
ADMIN_PASSWORD_HASH=your_pbkdf2_password_hash_here
ADMIN_PASSWORD_SALT=your_random_password_salt_here

# JWT Secret for signing session cookies
# (Auto-generated by `node set-password.js` if not already present)
JWT_SECRET=your_random_jwt_secret_here

# AES-256-GCM Encryption Key (Must be 64-hexadecimal characters / 32-bytes)
# (Auto-generated by `node set-password.js` if not already present)
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Vercel Blob Integration (Optional)
# This is automatically injected by Vercel if you connect your project to Vercel Blob.
# If omitted or empty, the server automatically saves files to the local `private_uploads/` folder.
BLOB_READ_WRITE_TOKEN=
